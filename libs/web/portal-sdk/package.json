    "react-router": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/vite": {"optional": true}
  },
  "devDependencies": {
    "@knightowl-vn/ui": "file:../ui",
    "@module-federation/vite": "^1.23.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
